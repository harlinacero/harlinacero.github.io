[
  {
    "id": "microservicesDemo",
    "projectId": "microservicesDemo",
    "repo": "https://github.com/harlinacero/Microservices.Demo",
    "layers": [
      { "id": "client", "nodes": [{ "id": "web", "tech": "Angular 14 · Nginx" }] },
      { "id": "edge", "nodes": [{ "id": "gateway", "tech": "ASP.NET Core · Ocelot · JWT" }] },
      {
        "id": "services",
        "nodes": [
          { "id": "auth", "tech": ".NET 6 · JWT" },
          { "id": "product", "tech": ".NET 6 · EF Core" },
          { "id": "pricing", "tech": ".NET 6 · Marten" },
          { "id": "policy", "tech": ".NET 6" },
          { "id": "report", "tech": ".NET 6" }
        ]
      },
      { "id": "messaging", "nodes": [{ "id": "rabbit", "tech": "RabbitMQ" }] },
      {
        "id": "data",
        "nodes": [
          { "id": "authDb", "tech": "MongoDB", "ownedBy": "auth" },
          { "id": "productDb", "tech": "SQL Server", "ownedBy": "product" },
          { "id": "pricingDb", "tech": "PostgreSQL", "ownedBy": "pricing" },
          { "id": "policyDb", "tech": "SQL Server", "ownedBy": "policy" }
        ]
      },
      {
        "id": "platform",
        "nodes": [
          { "id": "config", "tech": "Spring Cloud Config · Git" },
          { "id": "discovery", "tech": "Eureka" },
          { "id": "observability", "tech": "ELK · APM · Jaeger" }
        ]
      }
    ],
    "interactions": [
      { "id": "i1", "from": ["web"], "to": ["gateway"], "kind": "sync" },
      { "id": "i2", "from": ["gateway"], "to": ["auth", "product", "pricing", "policy", "report"], "kind": "sync" },
      { "id": "i3", "from": ["policy"], "to": ["pricing"], "kind": "sync" },
      { "id": "i4", "from": ["policy"], "to": ["rabbit"], "kind": "async" },
      { "id": "i5", "from": ["report"], "to": ["product", "policy"], "kind": "sync" },
      { "id": "i6", "from": ["gateway", "auth", "product", "pricing", "policy", "report"], "to": ["config"], "kind": "config" },
      { "id": "i7", "from": ["gateway", "auth", "product", "pricing", "policy", "report"], "to": ["discovery"], "kind": "config" },
      { "id": "i8", "from": ["gateway", "auth", "product", "pricing", "policy", "report"], "to": ["observability"], "kind": "telemetry" }
    ],
    "decisions": ["d1", "d2", "d3", "d4", "d5"],
    "qualities": ["scalability", "modifiability", "observability", "security"]
  },
